Algoritmo centimetrosConversion
	Definir a, yardas, metros, pies, pulgadas como real
	Escribir "Digite su numero a operar en centimetros "
	leer a
	yardas = a / 91.44
	metros = a / 100
	pies = a /30.48
	pulgadas = a / 2.54
	Escribir "su numero en yardas es: " yardas , " YD"
	Escribir "su numero en metros es: " metros , " M"
	Escribir "su numero en pies es: " pies , " FT"
	Escribir "su numero en pulgadas es: " pulgadas , " IN"
FinAlgoritmo