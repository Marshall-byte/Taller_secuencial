Algoritmo Salario
	Definir numeroHoras , valorHora, salarioPagar como real 
	Escribir "ingrese el numero de horas laboradas"
	Leer numeroHoras
	Escribir "ingrese el valor por hora"
	Leer valorHora
	salarioPagar = numeroHoras * valorHora
	Escribir "El salario por pagar es: , " salarioPagar
FinAlgoritmo

